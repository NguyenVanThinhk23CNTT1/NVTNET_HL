@model IEnumerable<NvtLab03MVC.Models.NvtBook>

<div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-header bg-gradient text-white fw-bold d-flex justify-content-between align-items-center" style="background-color: #0d6efd;">
        <span>⭐ SÁCH BÁN CHẠY NHẤT (GỌI TỪ VIEW COMPONENT)</span>
        <span class="badge bg-warning text-dark">HOT</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-3">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="pt-3">
                            <img src="~/images/products/@item.Image" alt="@item.Title" style="height: 90px; object-fit: cover;" class="rounded" />
                        </div>
                        <div class="card-body p-2 d-flex flex-column justify-content-between">
                            <h6 class="card-title text-truncate fw-bold mb-1">@item.Title</h6>
                            <p class="text-danger fw-semibold mb-0">@item.Price.ToString("N0") VNĐ</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>