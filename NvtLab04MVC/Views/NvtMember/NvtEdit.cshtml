@model NvtLab04MVC.Models.NvtMember

@{
    ViewData["Title"] = "Chỉnh sửa thành viên";
}

<div class="container my-4" style="max-width: 500px;">
    <h3 class="mb-4">Chỉnh sửa thành viên</h3>

    <form asp-action="NvtEdit" method="post">
        <input type="hidden" asp-for="MemberId" />

        <div class="mb-3">
            <label class="form-label fw-bold">Mã thành viên</label>
            <input asp-for="MemberId" class="form-control bg-light" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tên đăng nhập</label>
            <input asp-for="Username" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Họ và tên</label>
            <input asp-for="Fullname" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu</label>
            <input asp-for="Password" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
        <a asp-action="NvtIndex" class="btn btn-secondary px-3">Hủy</a>
    </form>
</div>