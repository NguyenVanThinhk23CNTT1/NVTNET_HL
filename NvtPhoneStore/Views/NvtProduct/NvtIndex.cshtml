@model IEnumerable<NvtPhoneStore.Models.NvtProduct>

@{
    ViewData["Title"] = "Danh sách điện thoại";
    var categories = ViewBag.Categories as List<string>;
    string priceSortParm = ViewData["PriceSortParm"] as string;
    string currentSort = ViewData["CurrentSort"] as string;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold mb-0">Danh sách Điện thoại (NvtProduct)</h2>
        <a asp-action="NvtCreate" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới sản phẩm
        </a>
    </div>

    <!-- KHU VỰC BỘ LỌC VÀ TÌM KIẾM (ASSIGNMENT) -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form asp-action="NvtIndex" method="get" class="row g-2 align-items-center">
                <!-- 1. Ô Tìm kiếm -->
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]"
                               class="form-control" placeholder="Nhập tên điện thoại cần tìm..." />
                    </div>
                </div>

                <!-- 2. Dropdown Lọc theo Hãng -->
                <div class="col-md-3">
                    <select name="category" class="form-select">
                        <option value="">-- Tất cả các Hãng --</option>
                        @if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                <option value="@cat" selected="@(cat == (string)ViewData["CurrentCategory"])">@cat</option>
                            }
                        }
                    </select>
                </div>

                <!-- 3. Nút submit Lọc & Nút Xóa lọc -->
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc & Tìm
                    </button>
                    <a asp-action="NvtIndex" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise me-1"></i> Xóa lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ DỮ LIỆU -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên điện thoại</th>
                        <th>Hãng</th>
                        <!-- SẮP XẾP THEO GIÁ (Bấm vào tiêu đề để đổi thứ tự tăng/giảm) -->
                        <th>
                            <a asp-action="NvtIndex"
                               asp-route-sortOrder="@priceSortParm"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-category="@ViewData["CurrentCategory"]"
                               class="text-white text-decoration-none">
                                Giá bán
                                @if (string.IsNullOrEmpty(currentSort))
                                {
                                    <i class="bi bi-sort-numeric-down text-warning"></i>
                                }
                                else if (currentSort == "price_desc")
                                {
                                    <i class="bi bi-sort-numeric-up-alt text-warning"></i>
                                }
                            </a>
                        </th>
                        <th>Tồn kho</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không tìm thấy sản phẩm nào phù hợp!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NvtProductId</td>
                                <td class="fw-bold text-dark">@item.NvtProductName</td>
                                <td><span class="badge bg-info text-dark">@item.NvtCategory</span></td>
                                <td class="text-danger fw-bold">@item.NvtPrice.ToString("N0") VNĐ</td>
                                <td>@item.NvtQuantity</td>
                                <td class="text-center">
                                    <a asp-action="NvtDetails" asp-route-id="@item.NvtProductId" class="btn btn-info btn-sm text-white">Xem</a>
                                    <a asp-action="NvtEdit" asp-route-id="@item.NvtProductId" class="btn btn-warning btn-sm">Sửa</a>
                                    <a asp-action="NvtDelete" asp-route-id="@item.NvtProductId" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>