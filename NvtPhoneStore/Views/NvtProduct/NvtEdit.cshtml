@model NvtPhoneStore.Models.NvtProduct

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Cập nhật sản phẩm</h4>
        </div>
        <div class="card-body">
            <form asp-action="NvtEdit" method="post">
                <input type="hidden" asp-for="NvtProductId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên điện thoại</label>
                    <input asp-for="NvtProductName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Hãng / Danh mục</label>
                    <input asp-for="NvtCategory" class="form-control" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="NvtPrice" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số lượng tồn</label>
                        <input asp-for="NvtQuantity" type="number" class="form-control" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="NvtDescription" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="NvtIndex" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-warning px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>