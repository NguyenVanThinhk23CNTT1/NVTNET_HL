@model IEnumerable<NvtHouseManagement.Models.NvtLoaiPhong>

@{
    ViewData["Title"] = "Quản lý Loại Phòng";
    
    var totalTypes = Model.Count();
    var avgPrice = Model.Any() ? Model.Average(m => m.GiaCoBan) : 0;
    var avgCapacity = Model.Any() ? Model.Average(m => m.SoNguoiToiDa) : 0;
    
    // Calculate overall occupancy
    var allRooms = Model.SelectMany(m => m.NvtPhongs).ToList();
    var totalRooms = allRooms.Count;
    var occupiedRooms = allRooms.Count(r => r.TrangThai == "Đã thuê");
    var occupancyRate = totalRooms > 0 ? (occupiedRooms * 100.0 / totalRooms) : 0;
}

<style>
    .main-card {
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #c7c4d8; border-radius: 10px; }
</style>

<!-- Header Section -->
<div class="flex justify-between items-end mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0 mb-2">Quản lý Loại Phòng</h2>
        <nav class="flex text-on-surface-variant text-[12px] font-medium m-0">
            <span class="hover:text-primary cursor-pointer">Dashboard</span>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Loại Phòng</span>
        </nav>
    </div>
    <button class="bg-primary text-white px-6 py-3 rounded-lg font-bold text-[14px] flex items-center gap-2 hover:bg-primary-container transition-all shadow-lg shadow-primary/20 border-0 cursor-pointer" onclick="openModal()">
        <span class="material-symbols-outlined">add</span>
        Thêm Loại Phòng
    </button>
</div>

<!-- Bento Layout Stats (Quick Glance) -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="main-card bg-white p-6 rounded-xl border border-slate-100">
        <div class="w-12 h-12 bg-indigo-50 rounded-lg flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-primary">category</span>
        </div>
        <p class="text-outline text-[12px] font-bold uppercase tracking-wider m-0">Tổng loại phòng</p>
        <h3 class="text-[28px] font-bold m-0 mt-1">@totalTypes.ToString("D2")</h3>
    </div>
    <div class="main-card bg-white p-6 rounded-xl border border-slate-100">
        <div class="w-12 h-12 bg-teal-50 rounded-lg flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-secondary">payments</span>
        </div>
        <p class="text-outline text-[12px] font-bold uppercase tracking-wider m-0">Đơn giá TB</p>
        <h3 class="text-[24px] font-bold m-0 mt-1">@(avgPrice >= 1000000 ? (avgPrice/1000000).ToString("0.#") + "M" : avgPrice.ToString("N0"))</h3>
    </div>
    <div class="main-card bg-white p-6 rounded-xl border border-slate-100">
        <div class="w-12 h-12 bg-orange-50 rounded-lg flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-tertiary">groups</span>
        </div>
        <p class="text-outline text-[12px] font-bold uppercase tracking-wider m-0">Sức chứa TB</p>
        <h3 class="text-[28px] font-bold m-0 mt-1">@Math.Round(avgCapacity) người</h3>
    </div>
    <div class="main-card bg-white p-6 rounded-xl border border-slate-100">
        <div class="w-12 h-12 bg-purple-50 rounded-lg flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-primary-fixed-dim">trending_up</span>
        </div>
        <p class="text-outline text-[12px] font-bold uppercase tracking-wider m-0">Tỷ lệ lấp đầy</p>
        <h3 class="text-[28px] font-bold m-0 mt-1">@Math.Round(occupancyRate)%</h3>
    </div>
</div>

<!-- Table Container -->
<div class="main-card bg-white rounded-xl border border-slate-100 overflow-hidden mb-10">
    <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-surface-container-lowest">
        <h3 class="text-[16px] font-bold m-0">Danh sách Loại Phòng</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse m-0">
            <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase">Mã Loại</th>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase">Tên Loại Phòng</th>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase text-right">Đơn Giá (VND)</th>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase text-center">Người Tối Đa</th>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase">Mô Tả</th>
                    <th class="px-6 py-4 text-[12px] font-bold text-outline uppercase text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @{
                    var colors = new[] { "indigo", "teal", "orange", "slate" };
                    int colorIdx = 0;
                }
                @foreach(var item in Model) {
                    var color = colors[colorIdx % colors.Length];
                    colorIdx++;
                    
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 text-[14px] font-bold">LP-@item.Id.ToString("D3")</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-md bg-@color-100 text-@(color == "slate" ? "on-surface-variant" : color == "indigo" ? "primary" : color == "teal" ? "teal-700" : "tertiary") flex items-center justify-center font-bold text-[14px] shrink-0">
                                    @(item.TenLoaiPhong.FirstOrDefault().ToString().ToUpper())
                                </div>
                                <span class="text-[16px] font-bold">@item.TenLoaiPhong</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="px-3 py-1 bg-@(color)-50 text-@(color == "slate" ? "on-surface-variant" : color == "indigo" ? "primary" : color == "teal" ? "teal-700" : "tertiary") rounded-full font-bold text-[12px]">
                                @item.GiaCoBan.ToString("N0")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center text-[14px]">@item.SoNguoiToiDa</td>
                        <td class="px-6 py-4 text-[14px] text-on-surface-variant max-w-xs truncate" title="@item.MoTa">@item.MoTa</td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex justify-center gap-2">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="p-2 border-0 bg-transparent text-primary hover:bg-primary/10 rounded-full transition-all flex items-center text-decoration-none">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0 inline" onsubmit="return confirm('Bạn có chắc muốn xóa loại phòng này?');">
                                    <button type="submit" class="p-2 border-0 bg-transparent text-error hover:bg-error/10 rounded-full transition-all flex items-center cursor-pointer">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                
                @if(!Model.Any()) {
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-outline text-[14px]">
                            Chưa có dữ liệu loại phòng.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if(Model.Any()) {
        <div class="p-6 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
            <p class="text-[14px] text-on-surface-variant m-0">Hiển thị 1-@Model.Count() trong số @Model.Count() loại phòng</p>
        </div>
    }
</div>

<!-- Modal: Thêm Loại Phòng -->
<div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[100] hidden items-center justify-center transition-opacity duration-300 opacity-0" id="modalOverlay">
    <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="modalContent">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-surface-container-lowest">
            <h3 class="text-[20px] font-bold m-0">Thêm Loại Phòng Mới</h3>
            <button class="border-0 bg-transparent text-on-surface-variant hover:bg-slate-200 rounded-full p-2 transition-all flex items-center cursor-pointer" onclick="closeModal()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form asp-action="Create" method="post" class="p-8 m-0" id="addTypeForm">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-2 gap-6 mb-6">
                <div class="col-span-2">
                    <label class="block text-[14px] font-bold text-on-surface mb-2">Tên Loại Phòng</label>
                    <input name="TenLoaiPhong" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="Ví dụ: Suite Cao Cấp" type="text" required/>
                </div>
                <div>
                    <label class="block text-[14px] font-bold text-on-surface mb-2">Đơn Giá (VND)</label>
                    <div class="relative">
                        <input name="GiaCoBan" class="w-full pl-4 pr-12 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="5000000" type="number" step="0.01" required/>
                        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[12px] font-bold">VND</span>
                    </div>
                </div>
                <div>
                    <label class="block text-[14px] font-bold text-on-surface mb-2">Số Người Tối Đa</label>
                    <div class="relative">
                        <input name="SoNguoiToiDa" class="w-full pl-4 pr-12 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="2" type="number" required/>
                        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[12px] font-bold">Người</span>
                    </div>
                </div>
                <div class="col-span-2">
                    <label class="block text-[14px] font-bold text-on-surface mb-2">Mô Tả</label>
                    <textarea name="MoTa" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all resize-none text-[14px]" placeholder="Mô tả chi tiết về tiện ích, trang thiết bị..." rows="4"></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-4 mt-8">
                <button type="button" class="border-0 bg-transparent px-6 py-3 text-primary text-[14px] font-bold hover:bg-primary/5 rounded-lg transition-all cursor-pointer" onclick="closeModal()">Hủy bỏ</button>
                <button type="submit" class="border-0 px-10 py-3 bg-primary text-white text-[14px] font-bold rounded-lg hover:bg-primary-container transition-all shadow-lg shadow-primary/20 cursor-pointer">Lưu Thông Tin</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modalOverlay = document.getElementById('modalOverlay');
        const modalContent = document.getElementById('modalContent');

        function openModal() {
            modalOverlay.classList.remove('hidden');
            modalOverlay.classList.add('flex');
            setTimeout(() => {
                modalOverlay.classList.remove('opacity-0');
                modalOverlay.classList.add('opacity-100');
                modalContent.classList.remove('scale-95');
                modalContent.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            modalOverlay.classList.remove('opacity-100');
            modalOverlay.classList.add('opacity-0');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                modalOverlay.classList.add('hidden');
                modalOverlay.classList.remove('flex');
            }, 300);
        }

        // Close modal when clicking outside
        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) closeModal();
        });
        
        document.getElementById('addTypeForm')?.addEventListener('submit', function(e) {
            const btn = this.querySelector('button[type="submit"]');
            btn.innerHTML = 'Đang lưu...';
            btn.classList.add('opacity-75', 'cursor-not-allowed');
        });
    </script>
}
