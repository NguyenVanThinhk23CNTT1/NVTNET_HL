@model NvtHouseManagement.Models.NvtLoaiPhong

@{
    ViewData["Title"] = "Chỉnh sửa Loại Phòng";
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Chỉnh sửa Loại Phòng</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtLoaiPhong")" class="text-on-surface-variant hover:text-primary text-decoration-none">Quản lý Loại Phòng</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Chỉnh sửa</span>
        </nav>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-2xl">
    <div class="px-8 py-6 border-b border-slate-100 bg-surface-container-lowest">
        <h3 class="text-[18px] font-bold text-on-surface m-0">Thông tin Loại Phòng: @Model.TenLoaiPhong</h3>
    </div>
    <form asp-action="Edit" class="p-8 m-0">
        <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="grid grid-cols-2 gap-6 space-y-0">
            <div class="col-span-2">
                <label asp-for="TenLoaiPhong" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Tên Loại Phòng</label>
                <input asp-for="TenLoaiPhong" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: Suite Cao Cấp" />
                <span asp-validation-for="TenLoaiPhong" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="GiaCoBan" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Đơn Giá (VND)</label>
                <div class="relative">
                    <input asp-for="GiaCoBan" type="number" step="0.01" class="w-full pl-4 pr-12 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="5000000" />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[12px] font-bold">VND</span>
                </div>
                <span asp-validation-for="GiaCoBan" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="SoNguoiToiDa" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Số Người Tối Đa</label>
                <div class="relative">
                    <input asp-for="SoNguoiToiDa" type="number" class="w-full pl-4 pr-12 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="2" />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline text-[12px] font-bold">Người</span>
                </div>
                <span asp-validation-for="SoNguoiToiDa" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="col-span-2">
                <label asp-for="MoTa" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Mô Tả</label>
                <textarea asp-for="MoTa" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] resize-none" placeholder="Mô tả chi tiết về tiện ích, trang thiết bị..." rows="4"></textarea>
                <span asp-validation-for="MoTa" class="text-error text-[12px] mt-1 block"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-lg border-0 bg-surface-container-low text-on-surface-variant text-[14px] font-bold hover:bg-surface-container transition-all text-decoration-none cursor-pointer flex items-center">
                Hủy bỏ
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer">
                Lưu Thay Đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
