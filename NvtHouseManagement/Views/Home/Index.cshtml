@{
    ViewData["Title"] = "Dashboard";
    
    // Dynamic binding if controller provides data, else fallbacks for mockup
    var tongSoPhong = ViewBag.TongSoPhong ?? 42;
    var soPhongTrong = ViewBag.SoPhongTrong ?? 8;
    var tongKhachThue = ViewBag.TongKhachThue ?? 34;
    var tongDoanhThu = ViewBag.TongDoanhThu ?? 156400000;
    var recentHoaDons = ViewBag.RecentHoaDons as IEnumerable<NvtHouseManagement.Models.NvtHoaDon>;
    var floorStats = ViewBag.FloorStats as IEnumerable<NvtHouseManagement.Models.FloorStatViewModel>;
}

<div class="max-w-[1600px] mx-auto space-y-10">
    <!-- Dashboard Title & Quick Actions -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
        <div>
            <h2 class="text-3xl font-extrabold text-on-surface tracking-tight mb-2 m-0">Chào buổi sáng, Admin! 👋</h2>
            <p class="text-on-surface-variant text-base font-medium m-0 mt-1">Hệ thống đang hoạt động ổn định. Xem báo cáo hôm nay.</p>
        </div>
        <div class="flex flex-wrap gap-4 p-2 ultra-glass rounded-3xl border border-white/60 shadow-xl">
            <a asp-controller="NvtKhachThue" asp-action="Create" class="text-decoration-none flex items-center gap-3 px-6 py-3.5 bg-primary text-white rounded-2xl font-bold shadow-lg shadow-primary/25 hover:translate-y-[-2px] hover:shadow-xl hover:text-white transition-all duration-300 group">
                <span class="material-symbols-outlined group-hover:rotate-90 transition-transform">add_circle</span>
                <span>Thêm Khách</span>
            </a>
            <a asp-controller="NvtChotDienNuoc" asp-action="Create" class="text-decoration-none flex items-center gap-3 px-6 py-3.5 bg-secondary text-white rounded-2xl font-bold shadow-lg shadow-secondary/25 hover:translate-y-[-2px] hover:shadow-xl hover:text-white transition-all duration-300">
                <span class="material-symbols-outlined">bolt</span>
                <span>Chốt Điện Nước</span>
            </a>
            <a asp-controller="NvtChotDienNuoc" asp-action="Create" class="text-decoration-none flex items-center gap-3 px-6 py-3.5 bg-white text-primary border border-primary/20 rounded-2xl font-bold hover:bg-primary/5 transition-all duration-300">
                <span class="material-symbols-outlined">request_quote</span>
                <span>Tạo Hóa Đơn</span>
            </a>
        </div>
    </div>
    
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Stat 1: TongSoPhong -->
        <div class="ultra-glass p-8 rounded-[2rem] border border-white/60 shadow-lg relative overflow-hidden group hover:translate-y-[-4px] transition-all duration-500">
            <div class="relative z-10 flex flex-col gap-6">
                <div class="flex justify-between items-center">
                    <div class="w-14 h-14 stat-card-gradient-1 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-indigo-500/30">
                        <span class="material-symbols-outlined text-3xl">door_open</span>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-1 rounded-lg">+2 tháng này</span>
                    </div>
                </div>
                <div>
                    <p class="text-on-surface-variant font-bold text-xs uppercase tracking-widest mb-1 m-0">Tổng Số Phòng</p>
                    <h3 class="text-4xl font-extrabold text-on-surface m-0">@tongSoPhong</h3>
                </div>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors"></div>
        </div>
        
        <!-- Stat 2: SoPhongTrong -->
        <div class="ultra-glass p-8 rounded-[2rem] border border-white/60 shadow-lg relative overflow-hidden group hover:translate-y-[-4px] transition-all duration-500">
            <div class="relative z-10 flex flex-col gap-6">
                <div class="flex justify-between items-center">
                    <div class="w-14 h-14 stat-card-gradient-2 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-orange-500/30">
                        <span class="material-symbols-outlined text-3xl">event_available</span>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] font-black text-orange-600 bg-orange-50 px-2 py-1 rounded-lg uppercase">Cần cho thuê</span>
                    </div>
                </div>
                <div>
                    <p class="text-on-surface-variant font-bold text-xs uppercase tracking-widest mb-1 m-0">Phòng Trống</p>
                    <h3 class="text-4xl font-extrabold text-on-surface m-0">@soPhongTrong</h3>
                </div>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-orange-500/5 rounded-full blur-3xl group-hover:bg-orange-500/10 transition-colors"></div>
        </div>
        
        <!-- Stat 3: TongKhachThue -->
        <div class="ultra-glass p-8 rounded-[2rem] border border-white/60 shadow-lg relative overflow-hidden group hover:translate-y-[-4px] transition-all duration-500">
            <div class="relative z-10 flex flex-col gap-6">
                <div class="flex justify-between items-center">
                    <div class="w-14 h-14 stat-card-gradient-3 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-sky-500/30">
                        <span class="material-symbols-outlined text-3xl">person_search</span>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-sky-600 bg-sky-50 px-2 py-1 rounded-lg">86% lấp đầy</span>
                    </div>
                </div>
                <div>
                    <p class="text-on-surface-variant font-bold text-xs uppercase tracking-widest mb-1 m-0">Tổng Khách Thuê</p>
                    <h3 class="text-4xl font-extrabold text-on-surface m-0">@tongKhachThue</h3>
                </div>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-sky-500/5 rounded-full blur-3xl group-hover:bg-sky-500/10 transition-colors"></div>
        </div>
        
        <!-- Stat 4: TongDoanhThu -->
        <div class="ultra-glass p-8 rounded-[2rem] border border-white/60 shadow-lg relative overflow-hidden group hover:translate-y-[-4px] transition-all duration-500">
            <div class="relative z-10 flex flex-col gap-6">
                <div class="flex justify-between items-center">
                    <div class="w-14 h-14 stat-card-gradient-4 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-emerald-500/30">
                        <span class="material-symbols-outlined text-3xl">payments</span>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-lg">↑ 12.5%</span>
                    </div>
                </div>
                <div>
                    <p class="text-on-surface-variant font-bold text-xs uppercase tracking-widest mb-1 m-0">Doanh Thu Tháng</p>
                    <h3 class="text-3xl font-extrabold text-on-surface m-0">@(((decimal)tongDoanhThu).ToString("N0"))đ</h3>
                </div>
            </div>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-emerald-500/5 rounded-full blur-3xl group-hover:bg-emerald-500/10 transition-colors"></div>
        </div>
    </div>
    
    <!-- Content Grid: Table + Charts -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-10">
        <!-- Table Section: Recent Invoices -->
        <div class="xl:col-span-2 ultra-glass rounded-[2.5rem] border border-white/60 shadow-xl overflow-hidden flex flex-col">
            <div class="p-8 border-b border-white/40 flex justify-between items-center">
                <div>
                    <h4 class="text-xl font-bold text-on-surface m-0">Hóa Đơn Gần Đây</h4>
                    <p class="text-on-surface-variant text-sm mt-1 m-0">Danh sách NvtHoaDon mới nhất được cập nhật tự động.</p>
                </div>
                <a asp-controller="NvtHoaDon" asp-action="Index" class="text-decoration-none px-5 py-2 rounded-xl bg-white border border-primary/10 text-primary font-bold text-sm hover:bg-primary hover:text-white transition-all shadow-sm">
                    Xem tất cả
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse m-0">
                    <thead>
                        <tr class="bg-primary/[0.02]">
                            <th class="px-8 py-5 text-[11px] font-black uppercase tracking-[0.15em] text-on-surface-variant/70 border-b border-white/30">Mã HĐ</th>
                            <th class="px-6 py-5 text-[11px] font-black uppercase tracking-[0.15em] text-on-surface-variant/70 border-b border-white/30">Kỳ Hạn</th>
                            <th class="px-6 py-5 text-[11px] font-black uppercase tracking-[0.15em] text-on-surface-variant/70 border-b border-white/30 text-right">Tổng Tiền</th>
                            <th class="px-6 py-5 text-[11px] font-black uppercase tracking-[0.15em] text-on-surface-variant/70 border-b border-white/30">Trạng Thái</th>
                            <th class="px-8 py-5 text-[11px] font-black uppercase tracking-[0.15em] text-on-surface-variant/70 border-b border-white/30 text-center">Tác vụ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/20">
                        @if(recentHoaDons != null && recentHoaDons.Any()) {
                            foreach(var item in recentHoaDons) {
                                var isPaid = item.TrangThai == "Đã thanh toán";
                                var isOverdue = item.TrangThai == "Quá hạn";
                                var statusClass = isPaid ? "bg-emerald-100 text-emerald-700 glow-green" : (isOverdue ? "bg-red-100 text-red-600 glow-red" : "bg-amber-100 text-amber-700 glow-amber");
                                
                                <tr class="hover:bg-white/60 transition-all duration-300 group">
                                    <td class="px-8 py-6 font-bold text-sm text-on-surface">#HD-@item.Nam-@(item.Id.ToString("D4"))</td>
                                    <td class="px-6 py-6 text-sm font-medium text-on-surface-variant">Tháng @item.Thang / @item.Nam</td>
                                    <td class="px-6 py-6 font-extrabold text-sm text-on-surface text-right">@item.TongTien.ToString("N0")đ</td>
                                    <td class="px-6 py-6">
                                        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider @statusClass">@item.TrangThai</span>
                                    </td>
                                    <td class="px-8 py-6 text-center">
                                        @if(isPaid) {
                                            <a href="@Url.Action("Index", "NvtHoaDon")" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-white border border-outline-variant/30 text-on-surface hover:border-primary hover:text-primary transition-all shadow-sm text-decoration-none">
                                                <span class="material-symbols-outlined text-[18px]">visibility</span>
                                            </a>
                                        } else {
                                            <a href="@Url.Action("Index", "NvtHoaDon")" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-secondary text-white font-bold text-xs shadow-md shadow-secondary/20 hover:scale-105 transition-all text-decoration-none">
                                                Thanh toán
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr>
                                <td colspan="5" class="px-8 py-10 text-center text-on-surface-variant">Chưa có hóa đơn nào được tạo.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Right Column: Occupancy Charts -->
        <div class="flex flex-col gap-10">
            <!-- Chart: Building Status -->
            <div class="ultra-glass rounded-[2.5rem] p-8 border border-white/60 shadow-xl">
                <h4 class="text-xl font-bold text-on-surface mb-8 m-0">Hiệu suất Lấp đầy</h4>
                <div class="space-y-8">
                    @if(floorStats != null && floorStats.Any()) {
                        foreach(var stat in floorStats) {
                            <div class="space-y-3">
                                <div class="flex justify-between items-end">
                                    <span class="text-sm font-bold text-on-surface">Tầng @stat.Tang <span class="text-xs font-normal text-on-surface-variant">(@stat.TotalRooms phòng)</span></span>
                                    <span class="text-sm font-black text-primary">@stat.OccupancyRate%</span>
                                </div>
                                <div class="h-3 w-full bg-white/50 rounded-full overflow-hidden p-[2px] border border-white/20">
                                    <div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full shadow-[0_0_8px_rgba(79,70,229,0.4)]" style="width: @stat.OccupancyRate%"></div>
                                </div>
                            </div>
                        }
                    } else {
                        <p class="text-on-surface-variant text-sm text-center py-4">Chưa có dữ liệu phòng.</p>
                    }
                </div>
                <a asp-controller="NvtPhong" asp-action="Index" class="block text-center w-full mt-10 py-4 rounded-2xl bg-primary text-white font-bold text-sm shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all border-0 cursor-pointer text-decoration-none">
                    Xem chi tiết sơ đồ mặt bằng
                </a>>
            </div>
            
            <!-- Visual Promo Card -->
            <div class="relative rounded-[2.5rem] h-56 overflow-hidden group shadow-2xl">
                <div class="absolute inset-0 bg-gradient-to-t from-indigo-950 via-indigo-950/40 to-transparent z-10 transition-opacity duration-500 group-hover:opacity-80"></div>
                <img alt="Building expansion" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?q=80&w=1000&auto=format&fit=crop"/>
                <div class="absolute bottom-8 left-8 right-8 z-20">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-1.5 h-1.5 bg-secondary rounded-full animate-ping"></span>
                        <span class="text-white/80 text-[10px] font-bold uppercase tracking-widest">Coming Soon</span>
                    </div>
                    <h5 class="text-white font-extrabold text-2xl tracking-tight leading-tight m-0">Mở rộng hệ thống</h5>
                    <p class="text-white/70 text-sm font-medium mt-1 m-0">Kết nối thêm các tòa nhà mới của bạn vào dashboard trung tâm ngay.</p>
                </div>
            </div>
        </div>
    </div>
</div>