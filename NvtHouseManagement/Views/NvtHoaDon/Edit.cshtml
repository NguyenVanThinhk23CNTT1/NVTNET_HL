@model NvtHouseManagement.Models.NvtHoaDon

@{
    ViewData["Title"] = "Chỉnh sửa Hóa Đơn";
}

<div class="max-w-4xl mx-auto my-8 mt-2">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-[28px] font-bold text-on-surface m-0">Chỉnh sửa Hóa đơn</h2>
            <p class="text-[16px] text-on-surface-variant m-0 mt-1">Cập nhật thông tin chi tiết của hóa đơn tháng @Model.Thang/@Model.Nam.</p>
        </div>
        <a asp-action="Index" class="flex items-center gap-2 px-4 py-2 bg-surface-container-high text-on-surface rounded-lg hover:bg-surface-container-highest transition-all font-medium text-decoration-none">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            Trở về danh sách
        </a>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 bg-surface-container-lowest flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                <span class="material-symbols-outlined">edit_document</span>
            </div>
            <div>
                <h3 class="text-[18px] font-bold text-on-surface m-0">Chi tiết hóa đơn</h3>
                <p class="text-[14px] text-on-surface-variant m-0">Chỉnh sửa các khoản phí nếu có sai sót</p>
            </div>
        </div>
        
        <form asp-action="Edit" class="p-8 space-y-8" id="editInvoiceForm">
            <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="HopDongId" />
            <input type="hidden" asp-for="NgayTao" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Left Column -->
                <div class="space-y-6">
                    <div>
                        <label asp-for="Thang" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Tháng</label>
                        <input asp-for="Thang" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none bg-slate-50" readonly />
                        <span asp-validation-for="Thang" class="text-error text-[12px]"></span>
                    </div>

                    <div>
                        <label asp-for="TienPhong" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Tiền phòng (VNĐ)</label>
                        <input asp-for="TienPhong" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none invoice-input font-medium" type="number" />
                        <span asp-validation-for="TienPhong" class="text-error text-[12px]"></span>
                    </div>

                    <div>
                        <label asp-for="TienDien" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Tiền điện (VNĐ)</label>
                        <input asp-for="TienDien" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none invoice-input font-medium" type="number" />
                        <span asp-validation-for="TienDien" class="text-error text-[12px]"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="space-y-6">
                    <div>
                        <label asp-for="Nam" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Năm</label>
                        <input asp-for="Nam" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none bg-slate-50" readonly />
                        <span asp-validation-for="Nam" class="text-error text-[12px]"></span>
                    </div>

                    <div>
                        <label asp-for="TienNuoc" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Tiền nước (VNĐ)</label>
                        <input asp-for="TienNuoc" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none invoice-input font-medium" type="number" />
                        <span asp-validation-for="TienNuoc" class="text-error text-[12px]"></span>
                    </div>

                    <div>
                        <label asp-for="TienDichVuKhac" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Dịch vụ khác / Phụ phí (VNĐ)</label>
                        <input asp-for="TienDichVuKhac" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none invoice-input font-medium" type="number" />
                        <span asp-validation-for="TienDichVuKhac" class="text-error text-[12px]"></span>
                    </div>
                </div>
            </div>

            <!-- Total Calculation Box -->
            <div class="mt-8 bg-surface-container-low p-6 rounded-xl border border-primary/20 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary shadow-sm">
                        <span class="material-symbols-outlined">calculate</span>
                    </div>
                    <div>
                        <p class="text-[12px] font-bold text-outline uppercase tracking-wider m-0 mb-1">Thành Tiền</p>
                        <p class="text-[14px] text-on-surface-variant m-0">Tự động cộng dồn các khoản phí</p>
                    </div>
                </div>
                <div class="text-right">
                    <input asp-for="TongTien" id="TongTien" class="hidden" />
                    <span class="text-[32px] font-bold text-primary" id="tongTienDisplay">@Model.TongTien.ToString("N0")</span>
                    <span class="text-[16px] text-on-surface-variant font-bold ml-1">VNĐ</span>
                    <span asp-validation-for="TongTien" class="text-error text-[12px] block mt-1"></span>
                </div>
            </div>

            <!-- Status -->
            <div class="pt-6 border-t border-slate-100 flex flex-col md:flex-row gap-6">
                <div class="flex-1">
                    <label asp-for="TrangThai" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Trạng thái thanh toán</label>
                    <select asp-for="TrangThai" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none font-bold">
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                        <option value="Đã thanh toán">Đã thanh toán</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-error text-[12px]"></span>
                </div>
                <div class="flex-1">
                    <label asp-for="NgayThanhToan" class="block text-[12px] font-bold text-outline uppercase tracking-wider mb-2">Ngày thanh toán</label>
                    <input asp-for="NgayThanhToan" class="w-full border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-[14px] py-2.5 px-3 outline-none" type="datetime-local" />
                    <span asp-validation-for="NgayThanhToan" class="text-error text-[12px]"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4">
                <a asp-action="Index" class="px-6 py-2.5 border border-outline-variant bg-transparent text-on-surface rounded-lg hover:bg-surface-container-lowest transition-all font-medium text-decoration-none">
                    Hủy bỏ
                </a>
                <button type="submit" class="flex items-center gap-2 px-6 py-2.5 bg-amber-500 text-white rounded-lg shadow-md hover:bg-amber-600 transition-all font-bold border-0 cursor-pointer">
                    <span class="material-symbols-outlined">save</span>
                    Lưu cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.invoice-input');
            const tongTienInput = document.getElementById('TongTien');
            const tongTienDisplay = document.getElementById('tongTienDisplay');

            function calculateTotal() {
                let total = 0;
                inputs.forEach(input => {
                    const value = parseFloat(input.value) || 0;
                    total += value;
                });
                
                // Update hidden input for model binding
                tongTienInput.value = total;
                
                // Update display
                tongTienDisplay.innerText = new Intl.NumberFormat('vi-VN').format(total);
            }

            inputs.forEach(input => {
                input.addEventListener('input', calculateTotal);
            });
        });
    </script>
}
