@model NvtHouseManagement.Models.NvtKhachThue

@{
    ViewData["Title"] = "Thêm Khách Thuê Mới";
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Thêm Khách Thuê Mới</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtKhachThue")" class="text-on-surface-variant hover:text-primary text-decoration-none">Quản lý Khách Thuê</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Thêm mới</span>
        </nav>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-3xl">
    <div class="px-8 py-6 border-b border-slate-100 bg-surface-container-lowest">
        <h3 class="text-[18px] font-bold text-on-surface m-0 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">person_add</span>
            Nhập thông tin cá nhân
        </h3>
    </div>
    <form asp-action="Create" class="p-8 m-0">
        <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 space-y-0">
            <div>
                <label asp-for="HoTen" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Họ và Tên <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">badge</span>
                    <input asp-for="HoTen" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="Nguyễn Văn A" required />
                </div>
                <span asp-validation-for="HoTen" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="Cccd" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Số CCCD / CMND <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">branding_watermark</span>
                    <input asp-for="Cccd" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="012345678910" required />
                </div>
                <span asp-validation-for="Cccd" class="text-error text-[12px] mt-1 block"></span>
            </div>

            <div>
                <label asp-for="SoDienThoai" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Số Điện Thoại <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">call</span>
                    <input asp-for="SoDienThoai" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="0987654321" required />
                </div>
                <span asp-validation-for="SoDienThoai" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="Email" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Email (Không bắt buộc)</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">mail</span>
                    <input asp-for="Email" type="email" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="email@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="md:col-span-2">
                <label asp-for="QueQuan" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Quê Quán / Địa chỉ thường trú</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">location_on</span>
                    <input asp-for="QueQuan" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="Số nhà, Phường/Xã, Quận/Huyện, Tỉnh/Thành..." />
                </div>
                <span asp-validation-for="QueQuan" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="md:col-span-2">
                <label asp-for="UserId" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Tài khoản liên kết (Nếu có)</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">link</span>
                    <input asp-for="UserId" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="Nhập ID hoặc Username tài khoản..." />
                </div>
                <span asp-validation-for="UserId" class="text-error text-[12px] mt-1 block"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-lg border-0 bg-surface-container-low text-on-surface-variant text-[14px] font-bold hover:bg-surface-container transition-all text-decoration-none cursor-pointer flex items-center">
                Hủy bỏ
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                Tạo Khách Mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
