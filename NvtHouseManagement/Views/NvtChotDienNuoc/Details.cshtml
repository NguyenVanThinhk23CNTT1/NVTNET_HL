@model NvtHouseManagement.Models.NvtChotDienNuoc

@{
    ViewData["Title"] = "Chi tiết Chốt Điện Nước";
    var dienTieuThu = Model.SoDienMoi - Model.SoDienCu;
    var nuocTieuThu = Model.SoNuocMoi - Model.SoNuocCu;
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Chi Tiết Kỳ Chốt Số</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtChotDienNuoc")" class="text-on-surface-variant hover:text-primary text-decoration-none">Chốt điện nước</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Tháng @Model.Thang/@Model.Nam</span>
        </nav>
    </div>
    
    <div class="flex gap-3">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="px-6 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md text-decoration-none flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">edit</span>
            Sửa số liệu
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Main Info -->
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-surface-container-lowest">
                <h3 class="text-[18px] font-bold text-on-surface m-0 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">data_usage</span>
                    Thông tin tiêu thụ
                </h3>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[12px] font-bold bg-primary/10 text-primary">
                    Kỳ: T @Model.Thang / @Model.Nam
                </span>
            </div>
            
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Box Điện -->
                <div class="border border-amber-200 bg-amber-50/50 rounded-xl overflow-hidden">
                    <div class="bg-amber-100 text-amber-800 font-bold text-center py-2 text-[14px] uppercase tracking-wider flex items-center justify-center gap-1 border-b border-amber-200">
                        <span class="material-symbols-outlined text-[18px]">bolt</span> Điện năng
                    </div>
                    <div class="p-6 text-center">
                        <p class="text-[12px] font-medium text-amber-700/80 mb-1 m-0">SỐ ĐIỆN TIÊU THỤ</p>
                        <p class="text-[40px] font-black text-amber-600 m-0 leading-none">@dienTieuThu <span class="text-[16px] font-bold text-amber-700/60">kWh</span></p>
                        
                        <div class="flex justify-between items-center mt-6 pt-4 border-t border-amber-200/60">
                            <div>
                                <p class="text-[11px] font-bold text-amber-700/70 m-0">SỐ CŨ</p>
                                <p class="text-[18px] font-bold text-amber-800 m-0">@Model.SoDienCu</p>
                            </div>
                            <span class="material-symbols-outlined text-amber-400">arrow_forward</span>
                            <div class="text-right">
                                <p class="text-[11px] font-bold text-amber-700/70 m-0">SỐ MỚI</p>
                                <p class="text-[18px] font-bold text-amber-800 m-0">@Model.SoDienMoi</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Box Nước -->
                <div class="border border-blue-200 bg-blue-50/50 rounded-xl overflow-hidden">
                    <div class="bg-blue-100 text-blue-800 font-bold text-center py-2 text-[14px] uppercase tracking-wider flex items-center justify-center gap-1 border-b border-blue-200">
                        <span class="material-symbols-outlined text-[18px]">water_drop</span> Nước sinh hoạt
                    </div>
                    <div class="p-6 text-center">
                        <p class="text-[12px] font-medium text-blue-700/80 mb-1 m-0">SỐ NƯỚC TIÊU THỤ</p>
                        <p class="text-[40px] font-black text-blue-600 m-0 leading-none">@nuocTieuThu <span class="text-[16px] font-bold text-blue-700/60">m3</span></p>
                        
                        <div class="flex justify-between items-center mt-6 pt-4 border-t border-blue-200/60">
                            <div>
                                <p class="text-[11px] font-bold text-blue-700/70 m-0">SỐ CŨ</p>
                                <p class="text-[18px] font-bold text-blue-800 m-0">@Model.SoNuocCu</p>
                            </div>
                            <span class="material-symbols-outlined text-blue-400">arrow_forward</span>
                            <div class="text-right">
                                <p class="text-[11px] font-bold text-blue-700/70 m-0">SỐ MỚI</p>
                                <p class="text-[18px] font-bold text-blue-800 m-0">@Model.SoNuocMoi</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="px-6 py-4 bg-surface-container-lowest border-t border-slate-100 flex items-center justify-between">
                <span class="text-[14px] text-on-surface-variant font-medium">Ngày thực hiện chốt số:</span>
                <span class="text-[14px] font-bold text-on-surface flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px] text-primary">calendar_today</span>
                    @(Model.NgayChot?.ToString("dd/MM/yyyy") ?? "Chưa có thông tin")
                </span>
            </div>
        </div>
    </div>

    <!-- Right Column: Sidebar / Actions -->
    <div class="space-y-6">
        @if (Model.Phong != null) {
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6">
                <h3 class="text-[16px] font-bold text-on-surface mb-4 m-0 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">meeting_room</span>
                    Phòng áp dụng
                </h3>
                <div class="text-center py-4 bg-surface-container-low rounded-xl mb-4">
                    <p class="text-[12px] font-bold text-on-surface-variant uppercase m-0">SỐ PHÒNG</p>
                    <p class="text-[36px] font-black text-primary m-0">@Model.Phong.SoPhong</p>
                </div>
            </div>
        }

        <div class="bg-surface-container-low rounded-xl shadow-sm border border-slate-100 p-6">
            <h3 class="text-[16px] font-bold text-on-surface mb-4 m-0 uppercase tracking-wider text-center">Thao tác</h3>
            
            <div class="flex flex-col gap-3">
                <a href="@Url.Action("Index")" class="w-full py-3 bg-white text-on-surface font-bold text-[14px] rounded-lg border border-slate-200 hover:bg-slate-50 transition-all text-center text-decoration-none">
                    Về danh sách
                </a>
                
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản chốt số này? Xóa không làm thay đổi các hóa đơn đã tạo từ nó.');">
                    <button type="submit" class="w-full py-3 bg-error/10 text-error font-bold text-[14px] rounded-lg border border-transparent hover:bg-error/20 transition-all cursor-pointer flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">delete_forever</span>
                        Xóa bản ghi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
