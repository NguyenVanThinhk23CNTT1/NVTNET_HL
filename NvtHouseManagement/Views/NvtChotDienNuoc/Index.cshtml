@model IEnumerable<NvtHouseManagement.Models.NvtChotDienNuoc>

@{
    ViewData["Title"] = "Quản lý Chốt Điện Nước";
    var totalReadings = Model.Count();
    var thisMonthReadings = Model.Count(x => x.Thang == DateTime.Now.Month && x.Nam == DateTime.Now.Year);
}

<!-- Page Header & Actions -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Quản Lý Chốt Điện Nước</h2>
        <p class="text-[14px] text-on-surface-variant m-0 mt-1">Theo dõi, ghi nhận số điện nước tiêu thụ hàng tháng của các phòng.</p>
    </div>
    <a href="@Url.Action("Create")" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg font-semibold hover:opacity-90 transition-all shadow-md active:scale-[0.98] border-0 text-decoration-none">
        <span class="material-symbols-outlined">electric_meter</span>
        <span>Chốt Số Mới</span>
    </a>
</div>

<!-- Stats Grid (Bento Style) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Tổng Lượt Chốt</span>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-bold text-on-surface m-0">@totalReadings</span>
            <span class="bg-teal-100 text-teal-700 text-[10px] px-2 py-0.5 rounded-full font-bold mb-2">TỪ TRƯỚC ĐẾN NAY</span>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Đã chốt tháng này</span>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-bold text-on-surface m-0">@thisMonthReadings</span>
            <span class="text-primary text-sm font-medium pb-1 mb-0">Phòng</span>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Đơn Giá Tham Khảo</span>
        <div class="flex flex-col gap-1 mt-1">
            <div class="flex items-center justify-between">
                <span class="text-[14px] font-medium text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[16px] text-amber-500">bolt</span> Điện:</span>
                <span class="text-[14px] font-bold">3,500đ / kWh</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-[14px] font-medium text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[16px] text-blue-500">water_drop</span> Nước:</span>
                <span class="text-[14px] font-bold">10,000đ / m3</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Data Table Container -->
<div class="bg-white rounded-xl border border-white/30 shadow-sm overflow-hidden flex flex-col mb-10">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse m-0">
            <thead>
                <tr class="bg-surface-container-low/50">
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider">Kỳ Chốt</th>
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider">Phòng</th>
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider text-center">Điện (kWh)</th>
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider text-center">Nước (m3)</th>
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider">Ngày Ghi</th>
                    <th class="px-6 py-4 text-[13px] font-bold text-on-surface-variant border-b border-surface-container uppercase tracking-wider text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-container">
                @foreach (var item in Model.OrderByDescending(x => x.Nam).ThenByDescending(x => x.Thang)) {
                    var dienTieuThu = item.SoDienMoi - item.SoDienCu;
                    var nuocTieuThu = item.SoNuocMoi - item.SoNuocCu;
                    
                    <tr class="hover:bg-surface-container-lowest transition-colors">
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-bold bg-primary/10 text-primary">
                                T @item.Thang/@item.Nam
                            </span>
                        </td>
                        <td class="px-6 py-4 text-[15px] font-bold text-on-surface">P.@item.Phong?.SoPhong</td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex flex-col items-center">
                                <span class="text-[16px] font-bold text-amber-600">@dienTieuThu</span>
                                <span class="text-[11px] text-outline">(@item.SoDienCu → @item.SoDienMoi)</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex flex-col items-center">
                                <span class="text-[16px] font-bold text-blue-600">@nuocTieuThu</span>
                                <span class="text-[11px] text-outline">(@item.SoNuocCu → @item.SoNuocMoi)</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-[14px] text-on-surface-variant">@(item.NgayChot?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="px-3 py-1.5 bg-blue-500 text-white rounded-md font-bold text-[12px] hover:bg-blue-600 transition-all text-decoration-none border-0 flex items-center justify-center gap-1 shadow-sm" title="Chi tiết">
                                    <span class="material-symbols-outlined text-[16px]">visibility</span>
                                    Xem
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="px-3 py-1.5 bg-amber-500 text-white rounded-md font-bold text-[12px] hover:bg-amber-600 transition-all text-decoration-none border-0 flex items-center justify-center gap-1 shadow-sm" title="Sửa">
                                    <span class="material-symbols-outlined text-[16px]">edit</span>
                                    Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu chốt này?');">
                                    <button type="submit" class="px-3 py-1.5 bg-red-500 text-white rounded-md font-bold text-[12px] hover:bg-red-600 transition-all text-decoration-none border-0 flex items-center justify-center gap-1 shadow-sm cursor-pointer" title="Xóa">
                                        <span class="material-symbols-outlined text-[16px]">delete</span>
                                        Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                
                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-outline text-[14px]">
                            Chưa có dữ liệu chốt điện nước. Bấm "Chốt Số Mới" để bắt đầu.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
