@model IEnumerable<NvtHouseManagement.Models.NvtPhong>

@{
    ViewData["Title"] = "Room Management";
    var totalRooms = Model.Count();
    var trong = Model.Count(r => r.TrangThai == "Trống" || string.IsNullOrEmpty(r.TrangThai));
    var daThue = Model.Count(r => r.TrangThai == "Đã thuê");
}

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .room-card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
</style>

<!-- Page Header & Filters -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Quản Lý Phòng Trọ</h2>
        <p class="text-on-surface-variant m-0 mt-1">Quản lý danh sách phòng, trạng thái và thông tin dãy trọ.</p>
    </div>
    <form method="get" class="flex flex-wrap items-center gap-4 m-0">
        <div class="flex flex-col gap-1">
            <label class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-0">Dãy Trọ</label>
            <select name="dayTroId" asp-items="ViewBag.DayTroId" class="bg-white border border-slate-200 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary shadow-none" onchange="this.form.submit()">
                <option value="">Tất cả dãy trọ</option>
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-0">Loại Phòng</label>
            <select name="loaiPhongId" asp-items="ViewBag.LoaiPhongId" class="bg-white border border-slate-200 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary shadow-none" onchange="this.form.submit()">
                <option value="">Tất cả loại phòng</option>
            </select>
        </div>
        <button type="submit" class="bg-surface-container-high text-primary px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 hover:bg-primary-fixed-dim transition-colors mt-auto border-0 cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">filter_list</span>
            Lọc
        </button>
        <a href="@Url.Action("Index")" class="text-on-surface-variant hover:text-primary mt-auto px-2 py-2 text-[14px] font-bold text-decoration-none">Xóa lọc</a>
    </form>
</div>

<!-- Stats Overview -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="glass-panel p-5 rounded-xl shadow-sm border-l-4 border-primary">
        <p class="text-on-surface-variant text-sm font-medium mb-1">Tổng Số Phòng</p>
        <h3 class="text-[36px] font-bold m-0">@totalRooms</h3>
    </div>
    <div class="glass-panel p-5 rounded-xl shadow-sm border-l-4 border-teal-500">
        <p class="text-on-surface-variant text-sm font-medium mb-1">Trống</p>
        <h3 class="text-[36px] font-bold m-0 text-teal-600">@trong</h3>
    </div>
    <div class="glass-panel p-5 rounded-xl shadow-sm border-l-4 border-orange-500">
        <p class="text-on-surface-variant text-sm font-medium mb-1">Đã Thuê</p>
        <h3 class="text-[36px] font-bold m-0 text-orange-600">@daThue</h3>
    </div>
    <div class="glass-panel p-5 rounded-xl shadow-sm border-l-4 border-error">
        <p class="text-on-surface-variant text-sm font-medium mb-1">Bảo Trì / Khác</p>
        <h3 class="text-[36px] font-bold m-0 text-error">@(totalRooms - trong - daThue)</h3>
    </div>
</div>

<!-- Room List Grid (Bento style grid) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    
    @foreach (var item in Model) {
        <div class="group relative bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden transition-all duration-300 room-card-hover">
            <div class="p-5">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <span class="text-xs font-bold text-outline uppercase">ID: @item.Id</span>
                        <h4 class="text-[20px] font-bold text-on-surface m-0 mt-1">Phòng @item.SoPhong</h4>
                        <p class="text-sm text-on-surface-variant m-0 mt-1">Tầng: @item.Tang • @(item.DayTro?.TenDayTro ?? $"Dãy {item.DayTroId}")</p>
                    </div>
                    @if (item.TrangThai == "Trống" || string.IsNullOrEmpty(item.TrangThai)) {
                        <span class="px-3 py-1 bg-teal-500/15 text-teal-700 text-[11px] font-bold rounded-full uppercase tracking-tight">Trống</span>
                    } else if (item.TrangThai == "Đã thuê") {
                        <span class="px-3 py-1 bg-orange-500/15 text-orange-700 text-[11px] font-bold rounded-full uppercase tracking-tight">Đã thuê</span>
                    } else {
                        <span class="px-3 py-1 bg-red-500/15 text-red-700 text-[11px] font-bold rounded-full uppercase tracking-tight">@item.TrangThai</span>
                    }
                </div>
                <div class="flex items-center gap-2 text-sm text-on-surface-variant mt-2">
                    <span class="material-symbols-outlined text-[18px]">category</span>
                    <span>@(item.LoaiPhong?.TenLoaiPhong ?? "Chưa phân loại")</span>
                </div>
            </div>
            <div class="bg-surface-container-low/50 backdrop-blur-sm p-4 flex gap-2 border-t border-slate-50">
                <a href="@Url.Action("Edit", new { id = item.Id })" class="text-decoration-none flex-1 py-2 px-3 bg-primary text-white rounded-lg text-[13px] font-bold flex justify-center items-center gap-2 hover:bg-primary/90 transition-all">
                    <span class="material-symbols-outlined text-[16px]">edit</span> Sửa
                </a>
                <a href="@Url.Action("Details", new { id = item.Id })" class="text-decoration-none flex-1 py-2 px-3 bg-blue-500/10 text-blue-600 rounded-lg text-[13px] font-bold flex justify-center items-center gap-2 hover:bg-blue-500/20 transition-all">
                    <span class="material-symbols-outlined text-[16px]">description</span> Xem
                </a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng này?');">
                    <button type="submit" class="border-0 text-decoration-none py-2 px-3 bg-red-500/10 text-red-600 rounded-lg text-[13px] font-bold flex justify-center items-center hover:bg-red-500/20 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Add New Placeholder Card -->
    <a href="@Url.Action("Create")" class="text-decoration-none group relative border-2 border-dashed border-slate-200 rounded-xl overflow-hidden transition-all duration-300 hover:border-primary/50 hover:bg-primary/5 flex flex-col items-center justify-center p-10 cursor-pointer min-h-[220px]">
        <div class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-[24px]">add</span>
        </div>
        <p class="mt-4 font-semibold text-on-surface-variant group-hover:text-primary transition-colors m-0">Thêm Phòng Mới</p>
    </a>
</div>

<!-- Floating Action Button -->
<a href="@Url.Action("Create")" class="text-decoration-none fixed bottom-8 right-8 w-14 h-14 bg-primary text-white rounded-full shadow-lg hover:shadow-xl hover:scale-110 active:scale-95 transition-all flex items-center justify-center z-50 group">
    <span class="material-symbols-outlined text-[28px]">add</span>
    <span class="absolute right-full mr-4 bg-inverse-surface text-inverse-on-surface px-3 py-1 rounded-lg text-sm whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">Thêm Phòng Mới</span>
</a>
