@model NvtHouseManagement.Models.NvtPhong

@{
    ViewData["Title"] = "Chỉnh sửa Phòng Trọ";
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Chỉnh sửa Phòng Trọ</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtPhong")" class="text-on-surface-variant hover:text-primary text-decoration-none">Quản lý Phòng Trọ</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Chỉnh sửa P.@Model.SoPhong</span>
        </nav>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-2xl">
    <div class="px-8 py-6 border-b border-slate-100 bg-surface-container-lowest">
        <h3 class="text-[18px] font-bold text-on-surface m-0">Cập nhật thông tin phòng</h3>
    </div>
    <form asp-action="Edit" class="p-8 m-0">
        <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="grid grid-cols-2 gap-6 space-y-0">
            <div>
                <label asp-for="SoPhong" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Số Phòng</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined text-[20px]">meeting_room</span>
                    <input asp-for="SoPhong" class="w-full pl-12 pr-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: 101, 102..." />
                </div>
                <span asp-validation-for="SoPhong" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="Tang" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Vị trí Tầng</label>
                <div class="relative">
                    <input asp-for="Tang" type="number" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="1" />
                </div>
                <span asp-validation-for="Tang" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="col-span-2">
                <label asp-for="DayTroId" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Thuộc Dãy Trọ</label>
                <div class="relative">
                    <select asp-for="DayTroId" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] appearance-none" asp-items="ViewBag.DayTroId">
                    </select>
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined pointer-events-none">expand_more</span>
                </div>
                <span asp-validation-for="DayTroId" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="col-span-2">
                <label asp-for="LoaiPhongId" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Loại Phòng</label>
                <div class="relative">
                    <select asp-for="LoaiPhongId" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] appearance-none" asp-items="ViewBag.LoaiPhongId">
                    </select>
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined pointer-events-none">expand_more</span>
                </div>
                <span asp-validation-for="LoaiPhongId" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div class="col-span-2">
                <label asp-for="TrangThai" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Trạng Thái</label>
                <div class="relative">
                    <select asp-for="TrangThai" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] appearance-none">
                        <option value="Trống">Trống</option>
                        <option value="Đã thuê">Đã thuê</option>
                        <option value="Đang sửa">Đang sửa chữa/Bảo trì</option>
                    </select>
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline material-symbols-outlined pointer-events-none">expand_more</span>
                </div>
                <span asp-validation-for="TrangThai" class="text-error text-[12px] mt-1 block"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-lg border-0 bg-surface-container-low text-on-surface-variant text-[14px] font-bold hover:bg-surface-container transition-all text-decoration-none cursor-pointer flex items-center">
                Hủy bỏ
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px]">save</span>
                Lưu Thay Đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
