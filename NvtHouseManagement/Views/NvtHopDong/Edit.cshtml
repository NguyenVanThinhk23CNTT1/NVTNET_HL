@model NvtHouseManagement.Models.NvtHopDong

@{
    ViewData["Title"] = "Chỉnh sửa Hợp Đồng";
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Chỉnh Sửa Hợp Đồng</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtHopDong")" class="text-on-surface-variant hover:text-primary text-decoration-none">Quản lý Hợp Đồng</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Cập nhật</span>
        </nav>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-4xl">
    <div class="px-8 py-6 border-b border-slate-100 bg-surface-container-lowest">
        <h3 class="text-[18px] font-bold text-on-surface m-0 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">edit_document</span>
            Thay đổi chi tiết hợp đồng
        </h3>
    </div>
    <form asp-action="Edit" class="p-8 m-0">
        <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 space-y-0">
            <!-- Room Selection -->
            <div>
                <label asp-for="PhongId" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Số Phòng <span class="text-error">*</span></label>
                <div class="relative">
                    <select asp-for="PhongId" class="w-full pl-4 pr-10 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary appearance-none outline-none shadow-none" asp-items="ViewBag.PhongId" required>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">expand_more</span>
                </div>
                <span asp-validation-for="PhongId" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <!-- Tenant Selection -->
            <div>
                <label asp-for="KhachThueId" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Khách Thuê <span class="text-error">*</span></label>
                <div class="relative">
                    <select asp-for="KhachThueId" class="w-full pl-4 pr-10 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary appearance-none outline-none shadow-none" asp-items="ViewBag.KhachThueId" required>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">expand_more</span>
                </div>
                <span asp-validation-for="KhachThueId" class="text-error text-[12px] mt-1 block"></span>
            </div>

            <!-- Start Date -->
            <div>
                <label asp-for="NgayBatDau" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Ngày Bắt Đầu <span class="text-error">*</span></label>
                <input asp-for="NgayBatDau" type="date" class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none shadow-none" required />
                <span asp-validation-for="NgayBatDau" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <!-- End Date -->
            <div>
                <label asp-for="NgayKetThuc" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Ngày Kết Thúc <span class="text-error">*</span></label>
                <input asp-for="NgayKetThuc" type="date" class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none shadow-none" required />
                <span asp-validation-for="NgayKetThuc" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <!-- Security Deposit -->
            <div>
                <label asp-for="TienCoc" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Tiền Cọc (VNĐ) <span class="text-error">*</span></label>
                <div class="relative">
                    <input asp-for="TienCoc" type="number" step="0.01" class="w-full pl-4 pr-12 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none shadow-none" required />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline font-medium">₫</span>
                </div>
                <span asp-validation-for="TienCoc" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <!-- Actual Rent -->
            <div>
                <label asp-for="GiaThueThucTe" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Giá Thuê Thực Tế (VNĐ) <span class="text-error">*</span></label>
                <div class="relative">
                    <input asp-for="GiaThueThucTe" type="number" step="0.01" class="w-full pl-4 pr-12 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none shadow-none" required />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline font-medium">₫</span>
                </div>
                <span asp-validation-for="GiaThueThucTe" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <!-- Status -->
            <div class="md:col-span-2">
                <label asp-for="TrangThai" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Trạng Thái Hợp Đồng <span class="text-error">*</span></label>
                <div class="relative">
                    <select asp-for="TrangThai" class="w-full pl-4 pr-10 py-3 bg-white border border-slate-200 rounded-lg text-[14px] focus:ring-2 focus:ring-primary/20 focus:border-primary appearance-none outline-none shadow-none">
                        <option value="Hiệu lực">Hiệu lực (Đang thuê)</option>
                        <option value="Hết hạn">Hết hạn (Chưa tái ký)</option>
                        <option value="Đã thanh lý">Đã thanh lý (Đã trả phòng)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">expand_more</span>
                </div>
                <span asp-validation-for="TrangThai" class="text-error text-[12px] mt-1 block"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-lg border-0 bg-surface-container-low text-on-surface-variant text-[14px] font-bold hover:bg-surface-container transition-all text-decoration-none cursor-pointer flex items-center">
                Hủy bỏ
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px]">save</span>
                Lưu Thay Đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
