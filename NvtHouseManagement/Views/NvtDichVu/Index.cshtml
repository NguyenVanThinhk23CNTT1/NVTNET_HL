@model IEnumerable<NvtHouseManagement.Models.NvtDichVu>

@{
    ViewData["Title"] = "Quản lý Dịch Vụ";
    
    // Helper function to pick icon based on service name
    string GetIconForService(string name) {
        var lower = name.ToLower();
        if (lower.Contains("điện")) return "bolt";
        if (lower.Contains("nước")) return "water_drop";
        if (lower.Contains("rác") || lower.Contains("vệ sinh")) return "cleaning_services";
        if (lower.Contains("wifi") || lower.Contains("mạng") || lower.Contains("internet")) return "wifi";
        if (lower.Contains("xe") || lower.Contains("giữ")) return "local_parking";
        if (lower.Contains("thang máy") || lower.Contains("bảo trì")) return "elevator";
        if (lower.Contains("an ninh") || lower.Contains("bảo vệ")) return "security";
        return "home_repair_service";
    }

    // Colors mapping
    var colors = new[] { "primary", "secondary", "tertiary", "error", "success" };
    int colorIdx = 0;
}

<style>
    /* Modal Animation */
    .modal-overlay { opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
    .modal-overlay.active { opacity: 1; pointer-events: auto; }
    .modal-content { transform: scale(0.95); transition: transform 0.3s ease; }
    .modal-overlay.active .modal-content { transform: scale(1); }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
</style>

<!-- Page Header -->
<div class="flex justify-between items-end mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0 mb-2">Quản lý Dịch Vụ</h2>
        <p class="text-on-surface-variant text-[14px] m-0">Thiết lập các loại phí dịch vụ đi kèm hàng tháng cho căn hộ</p>
    </div>
    <button class="bg-primary text-white px-6 py-3 rounded-lg font-bold text-[14px] flex items-center gap-2 shadow-lg hover:bg-primary-container transition-all active:scale-95 border-0 cursor-pointer" onclick="toggleModal(true)">
        <span class="material-symbols-outlined">add</span>
        Thêm Dịch Vụ
    </button>
</div>

<!-- Dashboard Stats Summary -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Tổng Dịch Vụ</span>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-bold text-on-surface m-0">@Model.Count()</span>
            <span class="bg-primary/10 text-primary text-[10px] px-2 py-0.5 rounded-full font-bold mb-2">ĐANG ÁP DỤNG</span>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Phí tính theo Tháng</span>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-bold text-on-surface m-0">@Model.Count(x => x.DonViTinh == "Tháng")</span>
            <span class="text-on-surface-variant text-sm font-medium pb-1 mb-0">Dịch vụ</span>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex flex-col gap-1 group hover:border-primary/30 transition-all">
        <span class="text-outline text-xs font-bold uppercase tracking-widest mb-0">Phí phát sinh khác</span>
        <div class="flex items-end gap-2">
            <span class="text-3xl font-bold text-on-surface m-0">@Model.Count(x => x.DonViTinh != "Tháng")</span>
            <span class="text-on-surface-variant text-sm font-medium pb-1 mb-0">Dịch vụ</span>
        </div>
    </div>
</div>

<!-- List View Alternative -->
<div class="mt-12 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/20 overflow-hidden">
        <div class="px-6 py-4 bg-surface-container-low flex justify-between items-center border-b border-outline-variant/20">
            <h3 class="text-[16px] font-bold text-on-surface m-0">Tất cả dịch vụ</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse m-0">
                <thead>
                    <tr class="bg-surface">
                        <th class="px-6 py-4 text-[12px] font-bold text-on-surface-variant border-b border-outline-variant/20 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-on-surface-variant border-b border-outline-variant/20 uppercase tracking-wider">Tên Dịch Vụ</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-on-surface-variant border-b border-outline-variant/20 uppercase tracking-wider text-right">Đơn Giá</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-on-surface-variant border-b border-outline-variant/20 uppercase tracking-wider text-center">Đơn Vị Tính</th>
                        <th class="px-6 py-4 text-[12px] font-bold text-on-surface-variant border-b border-outline-variant/20 uppercase tracking-wider text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10">
                    @{ colorIdx = 0; }
                    @foreach (var item in Model) {
                        var icon = GetIconForService(item.TenDichVu);
                        var color = colors[colorIdx % colors.Length];
                        colorIdx++;
                        var bgClass = color == "primary" ? "bg-primary/10" : color == "secondary" ? "bg-secondary/10" : color == "tertiary" ? "bg-tertiary/10" : color == "error" ? "bg-error/10" : "bg-green-100";
                        var textClass = color == "primary" ? "text-primary" : color == "secondary" ? "text-secondary" : color == "tertiary" ? "text-tertiary" : color == "error" ? "text-error" : "text-green-700";
                        
                        <tr class="hover:bg-surface-container-lowest transition-colors">
                            <td class="px-6 py-4 text-[14px] font-bold text-on-surface-variant">SV-@item.Id.ToString("D3")</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <span class="w-8 h-8 rounded @bgClass flex items-center justify-center @textClass shrink-0">
                                        <span class="material-symbols-outlined text-[18px]">@icon</span>
                                    </span>
                                    <span class="text-[14px] font-bold">@item.TenDichVu</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-[14px] text-primary font-bold text-right">@item.DonGia.ToString("N0")đ</td>
                            <td class="px-6 py-4 text-[14px] text-on-surface-variant text-center font-bold">@item.DonViTinh</td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="text-blue-500 hover:underline text-[12px] font-bold mr-4 text-decoration-none">Chi tiết</a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="text-secondary hover:underline text-[12px] font-bold mr-4 text-decoration-none">Sửa</a>
                                
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0 inline" onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này?');">
                                    <button type="submit" class="border-0 bg-transparent text-error hover:underline text-[12px] font-bold cursor-pointer">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    
                    @if(!Model.Any()) {
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center text-outline text-[14px]">
                                Hiện chưa có dịch vụ nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Thêm Dịch Vụ -->
<div class="modal-overlay fixed inset-0 z-[100] flex items-center justify-center p-6 bg-inverse-surface/40 backdrop-blur-sm" id="serviceModal">
    <div class="modal-content bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
        <div class="px-8 py-6 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-lowest">
            <h3 class="text-[20px] font-bold text-on-surface m-0">Thêm Dịch Vụ Mới</h3>
            <button class="border-0 bg-transparent text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer flex items-center" onclick="toggleModal(false)">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form asp-action="Create" method="post" class="p-8 space-y-6 m-0" id="addServiceForm">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-[12px] font-bold text-on-surface-variant mb-2 uppercase">Tên Dịch Vụ</label>
                <input name="TenDichVu" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: Tiền gửi xe, Bảo trì thang máy..." type="text" required/>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[12px] font-bold text-on-surface-variant mb-2 uppercase">Đơn Giá (VNĐ)</label>
                    <input name="DonGia" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="0" type="number" step="0.01" required/>
                </div>
                <div>
                    <label class="block text-[12px] font-bold text-on-surface-variant mb-2 uppercase">Đơn Vị Tính</label>
                    <select name="DonViTinh" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] appearance-none" required>
                        <option value="Tháng">Tháng</option>
                        <option value="Người">Người</option>
                        <option value="Phòng">Phòng</option>
                        <option value="kWh">kWh (Điện)</option>
                        <option value="m3">m3 (Nước)</option>
                        <option value="Lần">Lần</option>
                    </select>
                </div>
            </div>
            
            <div class="pt-4 flex gap-4">
                <button type="button" class="flex-1 px-6 py-3 rounded-lg border border-outline-variant bg-transparent text-on-surface-variant text-[14px] font-bold hover:bg-surface transition-colors cursor-pointer" onclick="toggleModal(false)">Hủy</button>
                <button type="submit" class="border-0 flex-1 px-6 py-3 rounded-lg bg-primary text-white text-[14px] font-bold shadow-md hover:bg-primary-container transition-all cursor-pointer">Lưu Dịch Vụ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModal(show) {
            const modal = document.getElementById('serviceModal');
            if (show) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') toggleModal(false);
        });
        
        document.getElementById('addServiceForm')?.addEventListener('submit', function(e) {
            const btn = this.querySelector('button[type="submit"]');
            btn.innerHTML = 'Đang lưu...';
            btn.classList.add('opacity-75', 'cursor-not-allowed');
        });
    </script>
}
