@model IEnumerable<NvtHouseManagement.Models.NvtDayTro>

@{
    ViewData["Title"] = "Quản lý Dãy Trọ";
    
    var totalHostels = Model.Count();
    var totalRooms = Model.Sum(d => d.NvtPhongs.Count);
    var vacantRooms = Model.Sum(d => d.NvtPhongs.Count(p => p.TrangThai == "Trống" || string.IsNullOrEmpty(p.TrangThai)));
}

<style>
    .glass-effect {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #c7c4d8; border-radius: 10px; }
</style>

<!-- Header Section -->
<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Quản lý Dãy Trọ</h2>
        <p class="text-[16px] text-on-surface-variant m-0 mt-1">Danh sách và thông tin chi tiết các dãy trọ đang quản lý.</p>
    </div>
    <button class="flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-bold text-[14px] hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer" onclick="toggleModal('addDayTroModal')">
        <span class="material-symbols-outlined">add</span>
        Thêm Dãy Trọ mới
    </button>
</div>

<!-- Dashboard Stats Summary (Bento Style) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined">apartment</span>
        </div>
        <div>
            <p class="text-[12px] font-bold text-on-surface-variant uppercase tracking-wider m-0">Tổng số dãy</p>
            <p class="text-[28px] font-bold m-0">@totalHostels.ToString("D2")</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center text-secondary shrink-0">
            <span class="material-symbols-outlined">meeting_room</span>
        </div>
        <div>
            <p class="text-[12px] font-bold text-on-surface-variant uppercase tracking-wider m-0">Tổng số phòng</p>
            <p class="text-[28px] font-bold m-0">@totalRooms</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-white/30 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-tertiary/10 flex items-center justify-center text-tertiary shrink-0">
            <span class="material-symbols-outlined">check_circle</span>
        </div>
        <div>
            <p class="text-[12px] font-bold text-on-surface-variant uppercase tracking-wider m-0">Phòng đang trống</p>
            <p class="text-[28px] font-bold m-0">@vacantRooms</p>
        </div>
    </div>
</div>

<!-- Table Container -->
<div class="bg-white rounded-xl border border-white/30 shadow-md overflow-hidden mb-10">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse m-0">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant border-b border-outline-variant/30">
                    <th class="px-6 py-4 text-[12px] font-bold uppercase tracking-wider">Mã Dãy</th>
                    <th class="px-6 py-4 text-[12px] font-bold uppercase tracking-wider">Tên Dãy Trọ</th>
                    <th class="px-6 py-4 text-[12px] font-bold uppercase tracking-wider">Địa Chỉ</th>
                    <th class="px-6 py-4 text-[12px] font-bold uppercase tracking-wider text-center">Số Lượng Phòng</th>
                    <th class="px-6 py-4 text-[12px] font-bold uppercase tracking-wider text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/20">
                @foreach (var item in Model) {
                    <tr class="hover:bg-surface-container-lowest transition-colors group">
                        <td class="px-6 py-4 text-[14px] font-medium text-on-surface-variant">DT-@item.Id.ToString("D3")</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-primary/5 flex items-center justify-center text-primary shrink-0">
                                    <span class="material-symbols-outlined">house</span>
                                </div>
                                <span class="text-[16px] font-bold text-on-surface">@item.TenDayTro</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-[14px] text-on-surface-variant">@item.DiaChi</td>
                        <td class="px-6 py-4 text-center">
                            <span class="bg-secondary/10 text-secondary px-3 py-1 rounded-full text-[12px] font-bold">@item.NvtPhongs.Count Phòng</span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex justify-end gap-2">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="p-2 border-0 bg-transparent text-primary hover:bg-primary/10 rounded-lg transition-all text-decoration-none flex items-center" title="Chỉnh sửa">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dãy trọ này?');">
                                    <button type="submit" class="p-2 border-0 bg-transparent text-error hover:bg-error/10 rounded-lg transition-all flex items-center cursor-pointer" title="Xóa">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                
                @if(!Model.Any()) {
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-outline text-[14px]">
                            Hiện chưa có dãy trọ nào. Hãy thêm một dãy trọ mới!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if(Model.Any()) {
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-outline-variant/30 flex items-center justify-between bg-surface-container-lowest">
            <p class="text-on-surface-variant text-[14px] m-0">Hiển thị 1 - @Model.Count() của @Model.Count() dãy trọ</p>
        </div>
    }
</div>

<!-- Modal: Add Day Tro -->
<div aria-labelledby="modal-title" aria-modal="true" class="fixed inset-0 z-[100] hidden overflow-y-auto" id="addDayTroModal" role="dialog">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div aria-hidden="true" class="fixed inset-0 transition-opacity bg-black/40 backdrop-blur-sm" onclick="toggleModal('addDayTroModal')"></div>
        <span aria-hidden="true" class="hidden sm:inline-block sm:align-middle sm:h-screen"></span>
        <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-white/20">
            <form asp-action="Create" method="post" class="m-0" id="addDayTroForm">
                @Html.AntiForgeryToken()
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-[24px] font-bold text-on-surface m-0" id="modal-title">Thêm Dãy Trọ Mới</h3>
                        <button type="button" class="border-0 bg-transparent text-on-surface-variant hover:text-error transition-colors flex items-center cursor-pointer" onclick="toggleModal('addDayTroModal')">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <p class="text-on-surface-variant text-[14px] mb-6">Nhập các thông tin cơ bản để tạo mới một dãy trọ trong hệ thống.</p>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Tên Dãy Trọ</label>
                            <input name="TenDayTro" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: Dãy A - Khu VIP" type="text" required/>
                        </div>
                        <div>
                            <label class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Địa Chỉ</label>
                            <input name="DiaChi" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: 123 Đường Lê Lợi, TP.HCM" type="text" required/>
                        </div>
                        <div>
                            <label class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Mô Tả / Ghi Chú</label>
                            <textarea name="MoTa" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] resize-none" placeholder="VD: Khu vực an ninh, gần chợ..." rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 bg-surface-container-low flex items-center justify-end gap-3">
                    <button type="button" class="border-0 bg-transparent px-6 py-2.5 rounded-lg text-[14px] font-bold text-on-surface-variant hover:bg-surface-container transition-all cursor-pointer" onclick="toggleModal('addDayTroModal')">Hủy bỏ</button>
                    <button type="submit" class="border-0 px-8 py-2.5 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md cursor-pointer">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModal(id) {
            const modal = document.getElementById(id);
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }
        
        document.getElementById('addDayTroForm')?.addEventListener('submit', function(e) {
            const btn = this.querySelector('button[type="submit"]');
            btn.innerHTML = 'Đang lưu...';
            btn.classList.add('opacity-75', 'cursor-not-allowed');
        });
    </script>
}
