@model NvtHouseManagement.Models.NvtDayTro

@{
    ViewData["Title"] = "Chỉnh sửa Dãy Trọ";
}

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 mt-2">
    <div>
        <h2 class="text-[28px] font-bold text-on-surface m-0">Chỉnh sửa Dãy Trọ</h2>
        <nav class="flex text-on-surface-variant text-[14px] font-medium m-0 mt-1">
            <a href="@Url.Action("Index", "Home")" class="text-on-surface-variant hover:text-primary text-decoration-none">Dashboard</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index", "NvtDayTro")" class="text-on-surface-variant hover:text-primary text-decoration-none">Quản lý Dãy Trọ</a>
            <span class="mx-2">/</span>
            <span class="text-primary font-bold">Chỉnh sửa</span>
        </nav>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-2xl">
    <div class="px-8 py-6 border-b border-slate-100 bg-surface-container-lowest">
        <h3 class="text-[18px] font-bold text-on-surface m-0">Thông tin Dãy Trọ: @Model.TenDayTro</h3>
    </div>
    <form asp-action="Edit" class="p-8 m-0">
        <div asp-validation-summary="ModelOnly" class="text-error text-[14px] mb-4"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="space-y-6">
            <div>
                <label asp-for="TenDayTro" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Tên Dãy Trọ</label>
                <input asp-for="TenDayTro" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: Dãy A - Khu VIP" />
                <span asp-validation-for="TenDayTro" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="DiaChi" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Địa Chỉ</label>
                <input asp-for="DiaChi" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px]" placeholder="VD: 123 Đường Lê Lợi, TP.HCM" />
                <span asp-validation-for="DiaChi" class="text-error text-[12px] mt-1 block"></span>
            </div>
            
            <div>
                <label asp-for="MoTa" class="block text-[12px] font-bold text-on-surface mb-2 uppercase">Mô Tả / Ghi Chú</label>
                <textarea asp-for="MoTa" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-[14px] resize-none" placeholder="VD: Khu vực an ninh, gần chợ..." rows="4"></textarea>
                <span asp-validation-for="MoTa" class="text-error text-[12px] mt-1 block"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index")" class="px-6 py-3 rounded-lg border-0 bg-surface-container-low text-on-surface-variant text-[14px] font-bold hover:bg-surface-container transition-all text-decoration-none cursor-pointer flex items-center">
                Hủy bỏ
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-lg text-[14px] font-bold hover:bg-primary-container transition-all shadow-md border-0 cursor-pointer">
                Lưu Thay Đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
